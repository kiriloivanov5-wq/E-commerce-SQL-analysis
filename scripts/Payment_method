WITH payment_summary AS (
    SELECT 
        country, 
        payment_method, 
        COUNT(payment_method) AS count_by_method
    FROM `ecommerce.transaction`
    GROUP BY 1, 2
)
SELECT 
    country, 
    payment_method, 
    count_by_method, 
    SUM(count_by_method) OVER(PARTITION BY country) AS payment_by_country,
    count_by_method / SUM(count_by_method) OVER(PARTITION BY country) * 100 AS percentage,
    ROW_NUMBER() OVER(PARTITION BY country ORDER BY count_by_method DESC) AS payment_rank
FROM payment_summary
